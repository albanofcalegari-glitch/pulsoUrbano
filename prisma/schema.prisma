generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @unique
  passwordHash          String    @map("password_hash")
  displayName           String?   @map("display_name")
  emailVerified         Boolean   @default(false) @map("email_verified")
  verificationCode      String?   @map("verification_code")
  verificationExpiresAt DateTime? @map("verification_expires_at") @db.Timestamptz()
  role                  String    @default("user")
  trustScore            Int       @default(10) @map("trust_score")
  trustStars            Int       @default(1) @map("trust_stars")
  reportsCount          Int       @default(0) @map("reports_count")
  confirmedReportsCount Int       @default(0) @map("confirmed_reports_count")
  rejectedReportsCount  Int       @default(0) @map("rejected_reports_count")
  flagsReceivedCount    Int       @default(0) @map("flags_received_count")
  isBlocked             Boolean   @default(false) @map("is_blocked")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  lastLoginAt           DateTime? @map("last_login_at") @db.Timestamptz()

  reports       Report[]
  confirmations ReportConfirmation[]
  removals      ReportRemoval[]
  flags         ReportFlag[]
  feedbacks     AppFeedback[]

  serviceProvider  ServiceProvider?
  jobRequests      JobRequest[]
  jobApplications  JobApplication[]
  reviewsGiven     JobReview[]        @relation("ReviewAuthor")
  reviewsReceived  JobReview[]        @relation("ReviewTarget")

  @@map("users")
}

model Report {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  category                 String    @default("dumpster")
  latitude                 Float
  longitude                Float
  reporterLatitude         Float?    @map("reporter_latitude")
  reporterLongitude        Float?    @map("reporter_longitude")
  locationAccuracyMeters   Float?    @map("location_accuracy_meters")
  distanceFromReportMeters Float?    @map("distance_from_report_meters")
  locationValidation       String    @default("unknown") @map("location_validation_status")
  status                   String    @default("seen")
  comment                  String?
  photoUrl                 String?   @map("photo_url")
  confidenceScore          Int       @default(0) @map("confidence_score")
  confirmationCount        Int       @default(0) @map("confirmation_count")
  removalCount             Int       @default(0) @map("removal_count")
  flagCount                Int       @default(0) @map("flag_count")
  moderationStatus         String    @default("pending") @map("moderation_status")
  reporterIp               String?   @map("reporter_ip")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  expiresAt                DateTime  @map("expires_at") @db.Timestamptz()
  lastConfirmedAt          DateTime? @map("last_confirmed_at") @db.Timestamptz()

  user          User                 @relation(fields: [userId], references: [id])
  confirmations ReportConfirmation[]
  removals      ReportRemoval[]
  flags         ReportFlag[]

  @@index([category])
  @@index([latitude, longitude])
  @@index([status])
  @@index([expiresAt])
  @@index([userId])
  @@index([moderationStatus])
  @@map("reports")
}

model ReportConfirmation {
  id        String   @id @default(uuid()) @db.Uuid
  reportId  String   @map("report_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([reportId, userId])
  @@index([reportId])
  @@map("report_confirmations")
}

model ReportRemoval {
  id        String   @id @default(uuid()) @db.Uuid
  reportId  String   @map("report_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([reportId, userId])
  @@index([reportId])
  @@map("report_removals")
}

model ReportFlag {
  id        String   @id @default(uuid()) @db.Uuid
  reportId  String   @map("report_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  ipAddress String?  @map("ip_address")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([reportId, userId])
  @@index([reportId])
  @@map("report_flags")
}

model AppFeedback {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  email      String?
  type       String
  message    String
  pageUrl    String?   @map("page_url")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  status     String    @default("new")
  adminNotes String?   @map("admin_notes")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz()

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("app_feedback")
}

// --- Capa 3: Marketplace de Servicios ---

model ServiceProvider {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  bio              String?  @db.Text
  phone            String?
  skills           String[]
  photoUrls        String[] @map("photo_urls")
  averageRating    Float    @default(0) @map("average_rating")
  totalJobs        Int      @default(0) @map("total_jobs")
  totalReviews     Int      @default(0) @map("total_reviews")
  isVerified       Boolean  @default(false) @map("is_verified")
  isActive         Boolean  @default(true) @map("is_active")
  moderationStatus String   @default("pending") @map("moderation_status")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user         User             @relation(fields: [userId], references: [id])
  applications JobApplication[]

  @@index([isActive])
  @@index([moderationStatus])
  @@map("service_providers")
}

model JobRequest {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  title              String    @db.VarChar(120)
  description        String    @db.Text
  category           String
  latitude           Float
  longitude          Float
  address            String?   @db.VarChar(300)
  budgetMin          Int?      @map("budget_min")
  budgetMax          Int?      @map("budget_max")
  urgency            String    @default("normal")
  status             String    @default("open")
  moderationStatus   String    @default("pending") @map("moderation_status")
  applicationsCount  Int       @default(0) @map("applications_count")
  selectedProviderId String?   @map("selected_provider_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz()

  user         User             @relation(fields: [userId], references: [id])
  applications JobApplication[]
  reviews      JobReview[]

  @@index([category])
  @@index([status])
  @@index([latitude, longitude])
  @@index([userId])
  @@index([moderationStatus])
  @@index([expiresAt])
  @@map("job_requests")
}

model JobApplication {
  id            String   @id @default(uuid()) @db.Uuid
  jobRequestId  String   @map("job_request_id") @db.Uuid
  providerId    String   @map("provider_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  message       String   @db.Text
  proposedPrice Int?     @map("proposed_price")
  estimatedTime String?  @map("estimated_time") @db.VarChar(100)
  status        String   @default("pending")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  jobRequest JobRequest      @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  provider   ServiceProvider @relation(fields: [providerId], references: [id])
  user       User            @relation(fields: [userId], references: [id])

  @@unique([jobRequestId, providerId])
  @@index([jobRequestId])
  @@index([providerId])
  @@map("job_applications")
}

model JobReview {
  id           String   @id @default(uuid()) @db.Uuid
  jobRequestId String   @map("job_request_id") @db.Uuid
  authorId     String   @map("author_id") @db.Uuid
  targetId     String   @map("target_id") @db.Uuid
  rating       Int
  comment      String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  jobRequest JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  author     User       @relation("ReviewAuthor", fields: [authorId], references: [id])
  target     User       @relation("ReviewTarget", fields: [targetId], references: [id])

  @@unique([jobRequestId, authorId])
  @@index([targetId])
  @@map("job_reviews")
}

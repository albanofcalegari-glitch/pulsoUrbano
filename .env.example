# ─── Base de datos ───
# Local: postgresql://volquetes:volquetes123@localhost:5434/volquetes
# Neon:  postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://volquetes:volquetes123@localhost:5434/volquetes"

# ─── Auth ───
# OBLIGATORIO en producción. Generar con: openssl rand -base64 32
JWT_SECRET="dev-secret-change-in-production"

# ─── Email (Resend) ───
# https://resend.com/api-keys — en dev sin API key, los códigos van a consola
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="Pulso Urbano <noreply@tudominio.com>"

# ─── Storage de imágenes ───
# "local" para desarrollo, "r2" para beta/producción
STORAGE_PROVIDER="local"

# Solo para STORAGE_PROVIDER=local
UPLOAD_DIR="./uploads"

# Solo para STORAGE_PROVIDER=r2 (Cloudflare R2)
# R2_ACCOUNT_ID="tu-account-id"
# R2_ACCESS_KEY_ID="tu-access-key"
# R2_SECRET_ACCESS_KEY="tu-secret-key"
# R2_BUCKET_NAME="ojo-urbano-photos"
# R2_PUBLIC_BASE_URL="https://pub-xxx.r2.dev"

# ─── App ───
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Defaults del mapa (Buenos Aires)
NEXT_PUBLIC_DEFAULT_LAT=-34.6037
NEXT_PUBLIC_DEFAULT_LNG=-58.3816
NEXT_PUBLIC_DEFAULT_ZOOM=13

# ─── Admin (solo para seed/create-admin) ───
# ADMIN_EMAIL="tu@email.com"
# ADMIN_PASSWORD="contraseña-segura-min-8-chars"
